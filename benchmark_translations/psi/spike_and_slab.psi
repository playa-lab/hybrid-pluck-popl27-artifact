def main() {
    x1 := [7, 1, 11, 11, 7, 11, 3, 1, 2, 21, 1, 11, 10];
    x2 := [26, 29, 56, 31, 52, 55, 71, 31, 54, 47, 40, 66, 68];
    x3 := [6, 15, 8, 8, 6, 9, 17, 22, 18, 4, 23, 9, 8];
    x4 := [60, 52, 20, 47, 33, 22, 6, 44, 22, 26, 34, 12, 12];
    ys := [78.5, 74.3, 104.3, 87.6, 95.9, 109.2, 102.7,
           72.5, 93.1, 115.9, 83.8, 113.3, 109.4];

    g1 := flip(0.5);
    g2 := flip(0.5);
    g3 := flip(0.5);
    g4 := flip(0.5);

    b1 := if g1 { gauss(0, 100) } else { 0 };
    b2 := if g2 { gauss(0, 100) } else { 0 };
    b3 := if g3 { gauss(0, 100) } else { 0 };
    b4 := if g4 { gauss(0, 100) } else { 0 };
    b0 := gauss(0, 10000);

    for i in [0..13) {
        mu := b0 + b1*x1[i] + b2*x2[i] + b3*x3[i] + b4*x4[i];
        cobserve(gauss(mu, 6.25), ys[i]);
    }
    return (g1, g2, g3, g4);
}
