def scaleOf(k:ℕ){
    return if k==0 {4.0/9.0} else { if k==1 {2.0/3.0} else { if k==2 {1.0}
           else { if k==3 {1.5} else { if k==4 {2.25} else {3.375} } } } };
}

def main(){
    a0:=gamma(1,1); a1:=gamma(1,1); a2:=gamma(1,1); sa:=a0+a1+a2;
    th0:=a0/sa; th1:=a1/sa; th2:=a2/sa;
    id0:=categorical([th0,th1,th2]);
    id1:=categorical([th0,th1,th2]);
    id2:=categorical([th0,th1,th2]);
    id3:=categorical([th0,th1,th2]);
    id4:=categorical([th0,th1,th2]);
    id5:=categorical([th0,th1,th2]);
    r0:=gamma(4,4); r1:=gamma(4,4); r2:=gamma(4,4); r3:=gamma(4,4); r4:=gamma(4,4); r5:=gamma(4,4);

    p:=id0+id1;  observe(poisson(r0*scaleOf(p+1))==1);  observe(poisson(r1*scaleOf(p))==2);
    p2:=id0+id2; observe(poisson(r0*scaleOf(p2+1))==1); observe(poisson(r2*scaleOf(p2))==1);
    p3:=id0+id3; observe(poisson(r0*scaleOf(p3+1))==2); observe(poisson(r3*scaleOf(p3))==3);
    p4:=id0+id4; observe(poisson(r0*scaleOf(p4+1))==0); observe(poisson(r4*scaleOf(p4))==0);
    p5:=id0+id5; observe(poisson(r0*scaleOf(p5+1))==2); observe(poisson(r5*scaleOf(p5))==5);
    p6:=id1+id0; observe(poisson(r1*scaleOf(p6+1))==3); observe(poisson(r0*scaleOf(p6))==1);
    p7:=id1+id2; observe(poisson(r1*scaleOf(p7+1))==1); observe(poisson(r2*scaleOf(p7))==0);
    p8:=id1+id3; observe(poisson(r1*scaleOf(p8+1))==5); observe(poisson(r3*scaleOf(p8))==0);
    p9:=id1+id4; observe(poisson(r1*scaleOf(p9+1))==1); observe(poisson(r4*scaleOf(p9))==0);
    p10:=id1+id5; observe(poisson(r1*scaleOf(p10+1))==0); observe(poisson(r5*scaleOf(p10))==1);
    p11:=id2+id0; observe(poisson(r2*scaleOf(p11+1))==3); observe(poisson(r0*scaleOf(p11))==1);
    p12:=id2+id1; observe(poisson(r2*scaleOf(p12+1))==0); observe(poisson(r1*scaleOf(p12))==0);
    p13:=id2+id3; observe(poisson(r2*scaleOf(p13+1))==1); observe(poisson(r3*scaleOf(p13))==3);
    p14:=id2+id4; observe(poisson(r2*scaleOf(p14+1))==1); observe(poisson(r4*scaleOf(p14))==0);
    p15:=id2+id5; observe(poisson(r2*scaleOf(p15+1))==3); observe(poisson(r5*scaleOf(p15))==1);
    p16:=id3+id0; observe(poisson(r3*scaleOf(p16+1))==5); observe(poisson(r0*scaleOf(p16))==2);
    p17:=id3+id1; observe(poisson(r3*scaleOf(p17+1))==1); observe(poisson(r1*scaleOf(p17))==1);
    p18:=id3+id2; observe(poisson(r3*scaleOf(p18+1))==3); observe(poisson(r2*scaleOf(p18))==1);
    p19:=id3+id4; observe(poisson(r3*scaleOf(p19+1))==1); observe(poisson(r4*scaleOf(p19))==0);
    p20:=id3+id5; observe(poisson(r3*scaleOf(p20+1))==0); observe(poisson(r5*scaleOf(p20))==2);
    p21:=id4+id0; observe(poisson(r4*scaleOf(p21+1))==0); observe(poisson(r0*scaleOf(p21))==1);
    p22:=id4+id1; observe(poisson(r4*scaleOf(p22+1))==0); observe(poisson(r1*scaleOf(p22))==0);
    p23:=id4+id2; observe(poisson(r4*scaleOf(p23+1))==1); observe(poisson(r2*scaleOf(p23))==0);
    p24:=id4+id3; observe(poisson(r4*scaleOf(p24+1))==1); observe(poisson(r3*scaleOf(p24))==0);
    p25:=id4+id5; observe(poisson(r4*scaleOf(p25+1))==1); observe(poisson(r5*scaleOf(p25))==1);
    p26:=id5+id0; observe(poisson(r5*scaleOf(p26+1))==3); observe(poisson(r0*scaleOf(p26))==2);
    p27:=id5+id1; observe(poisson(r5*scaleOf(p27+1))==0); observe(poisson(r1*scaleOf(p27))==0);
    p28:=id5+id2; observe(poisson(r5*scaleOf(p28+1))==2); observe(poisson(r2*scaleOf(p28))==2);
    p29:=id5+id3; observe(poisson(r5*scaleOf(p29+1))==2); observe(poisson(r3*scaleOf(p29))==1);
    p30:=id5+id4; observe(poisson(r5*scaleOf(p30+1))==0); observe(poisson(r4*scaleOf(p30))==0);

    return id0;
}
