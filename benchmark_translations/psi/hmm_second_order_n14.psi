def trans(prev) {
    return if prev == 0 { categorical([0.6, 0.3, 0.1]) }
           else { if prev == 1 { categorical([0.2, 0.6, 0.2]) } else { categorical([0.1, 0.3, 0.6]) } };
}

def main() {
    obs := [-2.52, -3.32, -1.52, -3.75, -1.99, -1.92, -0.39, -1.25, 1.35, 0.91, 1.8, -0.18, 3.84, 1.64];
    m1 := gauss(-2,1); m2 := gauss(0,1); m3 := gauss(2,1);

    z1 := categorical([0.5, 0.3, 0.2]);
    z2 := trans(z1);
    cobserve(gauss(if z1 == 0 { m1 } else { if z1 == 1 { m2 } else { m3 } }, 1), obs[0]);
    cobserve(gauss(if z2 == 0 { m1 } else { if z2 == 1 { m2 } else { m3 } }, 1), obs[1]);

    zp2 := z1;
    zp1 := z2;
    for n in [2..14) {
        mx := if zp2 >= zp1 { zp2 } else { zp1 };
        z := trans(mx);
        cobserve(gauss(if z == 0 { m1 } else { if z == 1 { m2 } else { m3 } }, 1), obs[n]);
        zp2 = zp1;
        zp1 = z;
    }
    return Expectation(m1);
}
