def main() {
    o0 := [-3.0, 3.0, 3.1, -2.9, 2.9, 3.0, -3.1, 3.1];
    o1 := [-2.9, 3.1, -3.0, -3.1, 3.0, -2.9, -3.0, 2.9];
    o2 := [-3.1, 2.9, -2.9, -3.0, 3.1, -3.1, -2.9, 3.0];

    m00 := gauss(-3,9); m01 := gauss(-3,9); m02 := gauss(-3,9);
    m10 := gauss(3,9); m11 := gauss(3,9); m12 := gauss(3,9);
    m20 := gauss(3,9); m21 := gauss(-3,9); m22 := gauss(-3,9);

    for n in [0..8) {
        z := categorical([0.34, 0.33, 0.33]);
        mu0 := if z == 0 { m00 } else { if z == 1 { m10 } else { m20 } };
        mu1 := if z == 0 { m01 } else { if z == 1 { m11 } else { m21 } };
        mu2 := if z == 0 { m02 } else { if z == 1 { m12 } else { m22 } };
        cobserve(gauss(mu0, 1), o0[n]);
        cobserve(gauss(mu1, 1), o1[n]);
        cobserve(gauss(mu2, 1), o2[n]);
    }
    return (m00, m01, m02, m10, m11, m12, m20, m21, m22);
}
