def observePrecinct(bw, bb, wc, bc, tt) {
    observe(binomial(wc, bw) + binomial(bc, bb) == tt);
}

def main() {
    bw := beta(1, 1);
    bb := beta(1, 1);

    observePrecinct(bw, bb, 18, 3, 8);
    observePrecinct(bw, bb, 10, 3, 5);
    observePrecinct(bw, bb, 18, 3, 8);
    observePrecinct(bw, bb, 2, 3, 3);
    observePrecinct(bw, bb, 1, 5, 5);
    observePrecinct(bw, bb, 0, 0, 0);
    observePrecinct(bw, bb, 6, 4, 5);
    observePrecinct(bw, bb, 2, 2, 3);
    observePrecinct(bw, bb, 17, 4, 9);
    observePrecinct(bw, bb, 4, 0, 2);
    observePrecinct(bw, bb, 5, 5, 6);
    observePrecinct(bw, bb, 8, 4, 6);
    observePrecinct(bw, bb, 6, 1, 3);
    observePrecinct(bw, bb, 1, 0, 1);
    observePrecinct(bw, bb, 13, 4, 8);
    observePrecinct(bw, bb, 11, 4, 8);
    observePrecinct(bw, bb, 1, 0, 1);
    observePrecinct(bw, bb, 13, 4, 9);
    observePrecinct(bw, bb, 1, 2, 3);
    observePrecinct(bw, bb, 4, 2, 3);
    observePrecinct(bw, bb, 1, 2, 3);
    observePrecinct(bw, bb, 0, 0, 0);
    observePrecinct(bw, bb, 1, 1, 1);

    return bw;
}
