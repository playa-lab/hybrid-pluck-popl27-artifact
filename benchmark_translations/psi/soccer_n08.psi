def scaleOf(k:ℕ){
    return if k==0 {4.0/9.0} else { if k==1 {2.0/3.0} else { if k==2 {1.0}
           else { if k==3 {1.5} else { if k==4 {2.25} else {3.375} } } } };
}

def main(){
    a0:=gamma(1,1); a1:=gamma(1,1); a2:=gamma(1,1); sa:=a0+a1+a2;
    th0:=a0/sa; th1:=a1/sa; th2:=a2/sa;
    id0:=categorical([th0,th1,th2]);
    id1:=categorical([th0,th1,th2]);
    id2:=categorical([th0,th1,th2]);
    id3:=categorical([th0,th1,th2]);
    id4:=categorical([th0,th1,th2]);
    id5:=categorical([th0,th1,th2]);
    id6:=categorical([th0,th1,th2]);
    id7:=categorical([th0,th1,th2]);
    r0:=gamma(4,4); r1:=gamma(4,4); r2:=gamma(4,4); r3:=gamma(4,4); r4:=gamma(4,4); r5:=gamma(4,4); r6:=gamma(4,4); r7:=gamma(4,4);

    p:=id0+id1;  observe(poisson(r0*scaleOf(p+1))==1);  observe(poisson(r1*scaleOf(p))==1);
    p2:=id0+id2; observe(poisson(r0*scaleOf(p2+1))==1); observe(poisson(r2*scaleOf(p2))==4);
    p3:=id0+id3; observe(poisson(r0*scaleOf(p3+1))==3); observe(poisson(r3*scaleOf(p3))==4);
    p4:=id0+id4; observe(poisson(r0*scaleOf(p4+1))==2); observe(poisson(r4*scaleOf(p4))==1);
    p5:=id0+id5; observe(poisson(r0*scaleOf(p5+1))==0); observe(poisson(r5*scaleOf(p5))==1);
    p6:=id0+id6; observe(poisson(r0*scaleOf(p6+1))==8); observe(poisson(r6*scaleOf(p6))==1);
    p7:=id0+id7; observe(poisson(r0*scaleOf(p7+1))==3); observe(poisson(r7*scaleOf(p7))==2);
    p8:=id1+id0; observe(poisson(r1*scaleOf(p8+1))==0); observe(poisson(r0*scaleOf(p8))==0);
    p9:=id1+id2; observe(poisson(r1*scaleOf(p9+1))==2); observe(poisson(r2*scaleOf(p9))==0);
    p10:=id1+id3; observe(poisson(r1*scaleOf(p10+1))==1); observe(poisson(r3*scaleOf(p10))==1);
    p11:=id1+id4; observe(poisson(r1*scaleOf(p11+1))==0); observe(poisson(r4*scaleOf(p11))==0);
    p12:=id1+id5; observe(poisson(r1*scaleOf(p12+1))==1); observe(poisson(r5*scaleOf(p12))==1);
    p13:=id1+id6; observe(poisson(r1*scaleOf(p13+1))==1); observe(poisson(r6*scaleOf(p13))==2);
    p14:=id1+id7; observe(poisson(r1*scaleOf(p14+1))==0); observe(poisson(r7*scaleOf(p14))==0);
    p15:=id2+id0; observe(poisson(r2*scaleOf(p15+1))==4); observe(poisson(r0*scaleOf(p15))==0);
    p16:=id2+id1; observe(poisson(r2*scaleOf(p16+1))==2); observe(poisson(r1*scaleOf(p16))==0);
    p17:=id2+id3; observe(poisson(r2*scaleOf(p17+1))==2); observe(poisson(r3*scaleOf(p17))==0);
    p18:=id2+id4; observe(poisson(r2*scaleOf(p18+1))==2); observe(poisson(r4*scaleOf(p18))==1);
    p19:=id2+id5; observe(poisson(r2*scaleOf(p19+1))==1); observe(poisson(r5*scaleOf(p19))==0);
    p20:=id2+id6; observe(poisson(r2*scaleOf(p20+1))==0); observe(poisson(r6*scaleOf(p20))==1);
    p21:=id2+id7; observe(poisson(r2*scaleOf(p21+1))==1); observe(poisson(r7*scaleOf(p21))==1);
    p22:=id3+id0; observe(poisson(r3*scaleOf(p22+1))==6); observe(poisson(r0*scaleOf(p22))==2);
    p23:=id3+id1; observe(poisson(r3*scaleOf(p23+1))==1); observe(poisson(r1*scaleOf(p23))==0);
    p24:=id3+id2; observe(poisson(r3*scaleOf(p24+1))==4); observe(poisson(r2*scaleOf(p24))==1);
    p25:=id3+id4; observe(poisson(r3*scaleOf(p25+1))==2); observe(poisson(r4*scaleOf(p25))==0);
    p26:=id3+id5; observe(poisson(r3*scaleOf(p26+1))==2); observe(poisson(r5*scaleOf(p26))==2);
    p27:=id3+id6; observe(poisson(r3*scaleOf(p27+1))==2); observe(poisson(r6*scaleOf(p27))==3);
    p28:=id3+id7; observe(poisson(r3*scaleOf(p28+1))==3); observe(poisson(r7*scaleOf(p28))==1);
    p29:=id4+id0; observe(poisson(r4*scaleOf(p29+1))==3); observe(poisson(r0*scaleOf(p29))==2);
    p30:=id4+id1; observe(poisson(r4*scaleOf(p30+1))==0); observe(poisson(r1*scaleOf(p30))==0);
    p31:=id4+id2; observe(poisson(r4*scaleOf(p31+1))==1); observe(poisson(r2*scaleOf(p31))==1);
    p32:=id4+id3; observe(poisson(r4*scaleOf(p32+1))==0); observe(poisson(r3*scaleOf(p32))==2);
    p33:=id4+id5; observe(poisson(r4*scaleOf(p33+1))==3); observe(poisson(r5*scaleOf(p33))==0);
    p34:=id4+id6; observe(poisson(r4*scaleOf(p34+1))==0); observe(poisson(r6*scaleOf(p34))==0);
    p35:=id4+id7; observe(poisson(r4*scaleOf(p35+1))==1); observe(poisson(r7*scaleOf(p35))==1);
    p36:=id5+id0; observe(poisson(r5*scaleOf(p36+1))==1); observe(poisson(r0*scaleOf(p36))==1);
    p37:=id5+id1; observe(poisson(r5*scaleOf(p37+1))==3); observe(poisson(r1*scaleOf(p37))==1);
    p38:=id5+id2; observe(poisson(r5*scaleOf(p38+1))==0); observe(poisson(r2*scaleOf(p38))==1);
    p39:=id5+id3; observe(poisson(r5*scaleOf(p39+1))==3); observe(poisson(r3*scaleOf(p39))==2);
    p40:=id5+id4; observe(poisson(r5*scaleOf(p40+1))==1); observe(poisson(r4*scaleOf(p40))==1);
    p41:=id5+id6; observe(poisson(r5*scaleOf(p41+1))==3); observe(poisson(r6*scaleOf(p41))==1);
    p42:=id5+id7; observe(poisson(r5*scaleOf(p42+1))==0); observe(poisson(r7*scaleOf(p42))==1);
    p43:=id6+id0; observe(poisson(r6*scaleOf(p43+1))==4); observe(poisson(r0*scaleOf(p43))==3);
    p44:=id6+id1; observe(poisson(r6*scaleOf(p44+1))==2); observe(poisson(r1*scaleOf(p44))==1);
    p45:=id6+id2; observe(poisson(r6*scaleOf(p45+1))==5); observe(poisson(r2*scaleOf(p45))==0);
    p46:=id6+id3; observe(poisson(r6*scaleOf(p46+1))==5); observe(poisson(r3*scaleOf(p46))==3);
    p47:=id6+id4; observe(poisson(r6*scaleOf(p47+1))==2); observe(poisson(r4*scaleOf(p47))==2);
    p48:=id6+id5; observe(poisson(r6*scaleOf(p48+1))==2); observe(poisson(r5*scaleOf(p48))==1);
    p49:=id6+id7; observe(poisson(r6*scaleOf(p49+1))==0); observe(poisson(r7*scaleOf(p49))==4);
    p50:=id7+id0; observe(poisson(r7*scaleOf(p50+1))==2); observe(poisson(r0*scaleOf(p50))==1);
    p51:=id7+id1; observe(poisson(r7*scaleOf(p51+1))==1); observe(poisson(r1*scaleOf(p51))==2);
    p52:=id7+id2; observe(poisson(r7*scaleOf(p52+1))==0); observe(poisson(r2*scaleOf(p52))==0);
    p53:=id7+id3; observe(poisson(r7*scaleOf(p53+1))==3); observe(poisson(r3*scaleOf(p53))==0);
    p54:=id7+id4; observe(poisson(r7*scaleOf(p54+1))==0); observe(poisson(r4*scaleOf(p54))==1);
    p55:=id7+id5; observe(poisson(r7*scaleOf(p55+1))==1); observe(poisson(r5*scaleOf(p55))==1);
    p56:=id7+id6; observe(poisson(r7*scaleOf(p56+1))==1); observe(poisson(r6*scaleOf(p56))==0);

    return id0;
}
