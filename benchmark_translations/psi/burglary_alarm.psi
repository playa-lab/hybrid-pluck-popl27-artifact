def main() {
    earthquake := flip(0.0001);
    burglary := flip(0.001);
    alarm := earthquake || burglary;
    phoneWorking := flip(if earthquake { 0.7 } else { 0.99 });
    maryWakes := flip(if alarm { if earthquake { 0.8 } else { 0.6 } } else { 0.2 });
    called := maryWakes && phoneWorking;
    observe(called);
    return Expectation(burglary);
}
