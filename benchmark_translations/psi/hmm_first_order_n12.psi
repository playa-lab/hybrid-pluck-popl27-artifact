def main() {
    obs := [0.26, -1.18, 0.83, -2.02, -2.06, -1.11, -2.39, -1.23, -1.39, -1.71, -2.19, -3.79];
    m1 := gauss(-2,1); m2 := gauss(0,1); m3 := gauss(2,1);

    z := categorical([0.5, 0.3, 0.2]);
    for n in [0..12) {
        mu := if z == 0 { m1 } else { if z == 1 { m2 } else { m3 } };
        cobserve(gauss(mu, 1), obs[n]);
        z = if z == 0 { categorical([0.6, 0.3, 0.1]) }
            else { if z == 1 { categorical([0.2, 0.6, 0.2]) } else { categorical([0.1, 0.3, 0.6]) } };
    }
    return Expectation(m1);
}
