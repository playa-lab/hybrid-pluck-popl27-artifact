def scaleOf(k:ℕ){
    return if k==0 {4.0/9.0} else { if k==1 {2.0/3.0} else { if k==2 {1.0}
           else { if k==3 {1.5} else { if k==4 {2.25} else {3.375} } } } };
}

def main(){
    a0:=gamma(1,1); a1:=gamma(1,1); a2:=gamma(1,1); sa:=a0+a1+a2;
    th0:=a0/sa; th1:=a1/sa; th2:=a2/sa;
    id0:=categorical([th0,th1,th2]);
    id1:=categorical([th0,th1,th2]);
    id2:=categorical([th0,th1,th2]);
    id3:=categorical([th0,th1,th2]);
    id4:=categorical([th0,th1,th2]);
    id5:=categorical([th0,th1,th2]);
    id6:=categorical([th0,th1,th2]);
    r0:=gamma(4,4); r1:=gamma(4,4); r2:=gamma(4,4); r3:=gamma(4,4); r4:=gamma(4,4); r5:=gamma(4,4); r6:=gamma(4,4);

    p:=id0+id1;  observe(poisson(r0*scaleOf(p+1))==0);  observe(poisson(r1*scaleOf(p))==3);
    p2:=id0+id2; observe(poisson(r0*scaleOf(p2+1))==3); observe(poisson(r2*scaleOf(p2))==2);
    p3:=id0+id3; observe(poisson(r0*scaleOf(p3+1))==1); observe(poisson(r3*scaleOf(p3))==2);
    p4:=id0+id4; observe(poisson(r0*scaleOf(p4+1))==2); observe(poisson(r4*scaleOf(p4))==1);
    p5:=id0+id5; observe(poisson(r0*scaleOf(p5+1))==2); observe(poisson(r5*scaleOf(p5))==1);
    p6:=id0+id6; observe(poisson(r0*scaleOf(p6+1))==5); observe(poisson(r6*scaleOf(p6))==2);
    p7:=id1+id0; observe(poisson(r1*scaleOf(p7+1))==2); observe(poisson(r0*scaleOf(p7))==0);
    p8:=id1+id2; observe(poisson(r1*scaleOf(p8+1))==2); observe(poisson(r2*scaleOf(p8))==0);
    p9:=id1+id3; observe(poisson(r1*scaleOf(p9+1))==0); observe(poisson(r3*scaleOf(p9))==2);
    p10:=id1+id4; observe(poisson(r1*scaleOf(p10+1))==1); observe(poisson(r4*scaleOf(p10))==0);
    p11:=id1+id5; observe(poisson(r1*scaleOf(p11+1))==0); observe(poisson(r5*scaleOf(p11))==1);
    p12:=id1+id6; observe(poisson(r1*scaleOf(p12+1))==1); observe(poisson(r6*scaleOf(p12))==1);
    p13:=id2+id0; observe(poisson(r2*scaleOf(p13+1))==3); observe(poisson(r0*scaleOf(p13))==1);
    p14:=id2+id1; observe(poisson(r2*scaleOf(p14+1))==1); observe(poisson(r1*scaleOf(p14))==2);
    p15:=id2+id3; observe(poisson(r2*scaleOf(p15+1))==1); observe(poisson(r3*scaleOf(p15))==1);
    p16:=id2+id4; observe(poisson(r2*scaleOf(p16+1))==2); observe(poisson(r4*scaleOf(p16))==0);
    p17:=id2+id5; observe(poisson(r2*scaleOf(p17+1))==2); observe(poisson(r5*scaleOf(p17))==0);
    p18:=id2+id6; observe(poisson(r2*scaleOf(p18+1))==2); observe(poisson(r6*scaleOf(p18))==1);
    p19:=id3+id0; observe(poisson(r3*scaleOf(p19+1))==1); observe(poisson(r0*scaleOf(p19))==4);
    p20:=id3+id1; observe(poisson(r3*scaleOf(p20+1))==1); observe(poisson(r1*scaleOf(p20))==0);
    p21:=id3+id2; observe(poisson(r3*scaleOf(p21+1))==1); observe(poisson(r2*scaleOf(p21))==2);
    p22:=id3+id4; observe(poisson(r3*scaleOf(p22+1))==2); observe(poisson(r4*scaleOf(p22))==1);
    p23:=id3+id5; observe(poisson(r3*scaleOf(p23+1))==5); observe(poisson(r5*scaleOf(p23))==1);
    p24:=id3+id6; observe(poisson(r3*scaleOf(p24+1))==6); observe(poisson(r6*scaleOf(p24))==3);
    p25:=id4+id0; observe(poisson(r4*scaleOf(p25+1))==0); observe(poisson(r0*scaleOf(p25))==0);
    p26:=id4+id1; observe(poisson(r4*scaleOf(p26+1))==1); observe(poisson(r1*scaleOf(p26))==0);
    p27:=id4+id2; observe(poisson(r4*scaleOf(p27+1))==1); observe(poisson(r2*scaleOf(p27))==0);
    p28:=id4+id3; observe(poisson(r4*scaleOf(p28+1))==1); observe(poisson(r3*scaleOf(p28))==1);
    p29:=id4+id5; observe(poisson(r4*scaleOf(p29+1))==0); observe(poisson(r5*scaleOf(p29))==0);
    p30:=id4+id6; observe(poisson(r4*scaleOf(p30+1))==0); observe(poisson(r6*scaleOf(p30))==1);
    p31:=id5+id0; observe(poisson(r5*scaleOf(p31+1))==2); observe(poisson(r0*scaleOf(p31))==2);
    p32:=id5+id1; observe(poisson(r5*scaleOf(p32+1))==1); observe(poisson(r1*scaleOf(p32))==0);
    p33:=id5+id2; observe(poisson(r5*scaleOf(p33+1))==1); observe(poisson(r2*scaleOf(p33))==3);
    p34:=id5+id3; observe(poisson(r5*scaleOf(p34+1))==3); observe(poisson(r3*scaleOf(p34))==6);
    p35:=id5+id4; observe(poisson(r5*scaleOf(p35+1))==1); observe(poisson(r4*scaleOf(p35))==0);
    p36:=id5+id6; observe(poisson(r5*scaleOf(p36+1))==2); observe(poisson(r6*scaleOf(p36))==2);
    p37:=id6+id0; observe(poisson(r6*scaleOf(p37+1))==4); observe(poisson(r0*scaleOf(p37))==1);
    p38:=id6+id1; observe(poisson(r6*scaleOf(p38+1))==3); observe(poisson(r1*scaleOf(p38))==2);
    p39:=id6+id2; observe(poisson(r6*scaleOf(p39+1))==3); observe(poisson(r2*scaleOf(p39))==0);
    p40:=id6+id3; observe(poisson(r6*scaleOf(p40+1))==8); observe(poisson(r3*scaleOf(p40))==3);
    p41:=id6+id4; observe(poisson(r6*scaleOf(p41+1))==3); observe(poisson(r4*scaleOf(p41))==0);
    p42:=id6+id5; observe(poisson(r6*scaleOf(p42+1))==3); observe(poisson(r5*scaleOf(p42))==0);

    return id0;
}
