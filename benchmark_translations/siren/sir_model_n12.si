
let symbolic rec <- beta(1., 1.) in
let symbolic inf <- beta(1., 1.) in
let symbolic bas <- beta(0.2, 1.) in
let symbolic sym <- beta(1., 1.) in
(* row 0 *)
let infected = false in
(* step 0 *) let () = observe(bernoulli(if infected then sym else bas), false) in let () = resample() in
let sample f0 <- bernoulli(if infected then rec else inf) in
let infected = if infected then (if f0 then false else true) else f0 in
