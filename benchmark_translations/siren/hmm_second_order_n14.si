


val draw_init = fun () ->
  let sample a <- bernoulli(0.5) in
  if a then 0 else (let sample b <- bernoulli(0.6) in if b then 1 else 2) in
val draw_tr = fun (prev) ->
  if (prev = 0)
    then (let sample a <- bernoulli(0.6) in if a then 0 else (let sample b <- bernoulli(0.75) in if b then 1 else 2))
    else (if (prev = 1)
      then (let sample a <- bernoulli(0.2) in if a then 0 else (let sample b <- bernoulli(0.75) in if b then 1 else 2))
      else (let sample a <- bernoulli(0.1) in if a then 0 else (let sample b <- bernoulli(0.3333333333333333) in if b then 1 else 2)))
in

let symbolic m1 <- gaussian(-2., 1.) in
let symbolic m2 <- gaussian(0., 1.) in
let symbolic m3 <- gaussian(2., 1.) in
let z1 = draw_init() in
let mean1 = if (z1 = 0) then m1 else (if (z1 = 1) then m2 else m3) in
let () = observe(gaussian(mean1, 1.), -2.52) in let () = resample() in
let z2 = draw_tr(z1) in
let mean2 = if (z2 = 0) then m1 else (if (z2 = 1) then m2 else m3) in
let () = observe(gaussian(mean2, 1.), -3.32) in let () = resample() in
let z3 = draw_tr((if (z1 < z2) then z2 else z1)) in
let mean3 = if (z3 = 0) then m1 else (if (z3 = 1) then m2 else m3) in
let () = observe(gaussian(mean3, 1.), -1.52) in let () = resample() in
let z4 = draw_tr((if (z2 < z3) then z3 else z2)) in
let mean4 = if (z4 = 0) then m1 else (if (z4 = 1) then m2 else m3) in
let () = observe(gaussian(mean4, 1.), -3.75) in let () = resample() in
let z5 = draw_tr((if (z3 < z4) then z4 else z3)) in
let mean5 = if (z5 = 0) then m1 else (if (z5 = 1) then m2 else m3) in
let () = observe(gaussian(mean5, 1.), -1.99) in let () = resample() in
let z6 = draw_tr((if (z4 < z5) then z5 else z4)) in
let mean6 = if (z6 = 0) then m1 else (if (z6 = 1) then m2 else m3) in
let () = observe(gaussian(mean6, 1.), -1.92) in let () = resample() in
let z7 = draw_tr((if (z5 < z6) then z6 else z5)) in
let mean7 = if (z7 = 0) then m1 else (if (z7 = 1) then m2 else m3) in
let () = observe(gaussian(mean7, 1.), -0.39) in let () = resample() in
let z8 = draw_tr((if (z6 < z7) then z7 else z6)) in
let mean8 = if (z8 = 0) then m1 else (if (z8 = 1) then m2 else m3) in
let () = observe(gaussian(mean8, 1.), -1.25) in let () = resample() in
let z9 = draw_tr((if (z7 < z8) then z8 else z7)) in
let mean9 = if (z9 = 0) then m1 else (if (z9 = 1) then m2 else m3) in
let () = observe(gaussian(mean9, 1.), 1.35) in let () = resample() in
let z10 = draw_tr((if (z8 < z9) then z9 else z8)) in
let mean10 = if (z10 = 0) then m1 else (if (z10 = 1) then m2 else m3) in
let () = observe(gaussian(mean10, 1.), 0.91) in let () = resample() in
let z11 = draw_tr((if (z9 < z10) then z10 else z9)) in
let mean11 = if (z11 = 0) then m1 else (if (z11 = 1) then m2 else m3) in
let () = observe(gaussian(mean11, 1.), 1.8) in let () = resample() in
let z12 = draw_tr((if (z10 < z11) then z11 else z10)) in
let mean12 = if (z12 = 0) then m1 else (if (z12 = 1) then m2 else m3) in
let () = observe(gaussian(mean12, 1.), -0.18) in let () = resample() in
let z13 = draw_tr((if (z11 < z12) then z12 else z11)) in
let mean13 = if (z13 = 0) then m1 else (if (z13 = 1) then m2 else m3) in
let () = observe(gaussian(mean13, 1.), 3.84) in let () = resample() in
let z14 = draw_tr((if (z12 < z13) then z13 else z12)) in
let mean14 = if (z14 = 0) then m1 else (if (z14 = 1) then m2 else m3) in
let () = observe(gaussian(mean14, 1.), 1.64) in let () = resample() in
m1
