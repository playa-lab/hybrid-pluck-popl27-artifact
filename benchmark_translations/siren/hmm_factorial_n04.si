


val draw_init = fun () ->
  let sample a <- bernoulli(0.5) in
  if a then 0 else (let sample b <- bernoulli(0.6) in if b then 1 else 2) in
val draw_tr = fun (prev) ->
  if (prev = 0)
    then (let sample a <- bernoulli(0.6) in if a then 0 else (let sample b <- bernoulli(0.75) in if b then 1 else 2))
    else (if (prev = 1)
      then (let sample a <- bernoulli(0.2) in if a then 0 else (let sample b <- bernoulli(0.75) in if b then 1 else 2))
      else (let sample a <- bernoulli(0.1) in if a then 0 else (let sample b <- bernoulli(0.3333333333333333) in if b then 1 else 2)))
in

let symbolic mu0 <- gaussian(-3.0, 1.) in
let symbolic mu1 <- gaussian(-1.5, 1.) in
let symbolic mu2 <- gaussian(-0.5, 1.) in
let symbolic mu3 <- gaussian(1.0, 1.) in
let symbolic mu4 <- gaussian(0.0, 1.) in
let symbolic mu5 <- gaussian(2.0, 1.) in
let symbolic mu6 <- gaussian(0.0, 1.) in
let symbolic mu7 <- gaussian(0.0, 1.) in
let symbolic mu8 <- gaussian(3.5, 1.) in
let z1 = draw_init() in
let h1 = draw_init() in
let mean1 = if (z1 = 0) then (if (h1 = 0) then mu0 else (if (h1 = 1) then mu1 else mu2)) else (if (z1 = 1) then (if (h1 = 0) then mu1 else (if (h1 = 1) then mu3 else mu5)) else (if (h1 = 0) then mu2 else (if (h1 = 1) then mu5 else mu8))) in
let () = observe(gaussian(mean1, 1.), -0.51) in let () = resample() in
let z2 = draw_tr(z1) in
let h2 = draw_tr(h1) in
let mean2 = if (z2 = 0) then (if (h2 = 0) then mu0 else (if (h2 = 1) then mu1 else mu2)) else (if (z2 = 1) then (if (h2 = 0) then mu1 else (if (h2 = 1) then mu3 else mu5)) else (if (h2 = 0) then mu2 else (if (h2 = 1) then mu5 else mu8))) in
let () = observe(gaussian(mean2, 1.), -2.01) in let () = resample() in
let z3 = draw_tr(z2) in
let h3 = draw_tr(h2) in
let mean3 = if (z3 = 0) then (if (h3 = 0) then mu0 else (if (h3 = 1) then mu1 else mu2)) else (if (z3 = 1) then (if (h3 = 0) then mu1 else (if (h3 = 1) then mu3 else mu5)) else (if (h3 = 0) then mu2 else (if (h3 = 1) then mu5 else mu8))) in
let () = observe(gaussian(mean3, 1.), -2.72) in let () = resample() in
let z4 = draw_tr(z3) in
let h4 = draw_tr(h3) in
let mean4 = if (z4 = 0) then (if (h4 = 0) then mu0 else (if (h4 = 1) then mu1 else mu2)) else (if (z4 = 1) then (if (h4 = 0) then mu1 else (if (h4 = 1) then mu3 else mu5)) else (if (h4 = 0) then mu2 else (if (h4 = 1) then mu5 else mu8))) in
let () = observe(gaussian(mean4, 1.), -2.79) in let () = resample() in
mu0
