


let symbolic p0 <- beta(1., 1.) in
let symbolic p1 <- beta(1., 1.) in
let symbolic p2 <- beta(1., 1.) in
let symbolic p3 <- beta(1., 1.) in
let sample v0_0 <- bernoulli(p0) in
let sample v0_1 <- bernoulli(p1) in
let sample v0_2 <- bernoulli(p2) in
let sample v0_3 <- bernoulli(p3) in
let sample v0_4 <- bernoulli(p0) in
let yes0 = ((if v0_0 then 1 else 0) + (if v0_1 then 1 else 0) + (if v0_2 then 1 else 0) + (if v0_3 then 1 else 0) + (if v0_4 then 1 else 0)) in
let () = observe(binomial(0, 0.5), if (5 < (2 * yes0)) then 0 else 1) in let () = resample() in
let sample v1_0 <- bernoulli(p2) in
let sample v1_1 <- bernoulli(p3) in
let sample v1_2 <- bernoulli(p0) in
let sample v1_3 <- bernoulli(p1) in
let sample v1_4 <- bernoulli(p2) in
let yes1 = ((if v1_0 then 1 else 0) + (if v1_1 then 1 else 0) + (if v1_2 then 1 else 0) + (if v1_3 then 1 else 0) + (if v1_4 then 1 else 0)) in
let () = observe(binomial(0, 0.5), if (5 < (2 * yes1)) then 0 else 1) in let () = resample() in
