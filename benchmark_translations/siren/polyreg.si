


val draw_len = fun () ->
  let sample a <- bernoulli(0.3) in
  if a then 0
  else (
    let sample b <- bernoulli(0.3) in
    if b then 1
    else (
      let sample c <- bernoulli(0.3) in
      if c then 2
      else (
        let sample d <- bernoulli(0.3) in
        if d then 3
        else (
          let sample e <- bernoulli(0.3) in
          if e then 4
          else 5))))
in
val draw_oidx = fun () -> let sample i <- uniform_int(0, 9) in i in
let symbolic c0 <- gaussian(0., 10000.0) in
let symbolic c1 <- gaussian(0., 10000.0) in
let symbolic c2 <- gaussian(0., 10000.0) in
let symbolic c3 <- gaussian(0., 10000.0) in
let symbolic c4 <- gaussian(0., 10000.0) in
let len = draw_len() in
let oidx = draw_oidx() in
let () = observe(gaussian(if (oidx = 0) then 0.0 else ((if 0 < len then c0 * 1.0 else 0.0) + (if 1 < len then c1 * 0.1 else 0.0) + (if 2 < len then c2 * 0.010000000000000002 else 0.0) + (if 3 < len then c3 * 0.0010000000000000002 else 0.0) + (if 4 < len then c4 * 0.00010000000000000002 else 0.0)), if (oidx = 0) then 40000.0 else 1.0), 1.3998703068665284) in
