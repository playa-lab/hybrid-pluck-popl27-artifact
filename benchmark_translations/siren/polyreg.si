let () = observe(gaussian(if (oidx = 3) then 0.0 else ((if 0 < len then c0 * 1.0 else 0.0) + (if 1 < len then c1 * 0.4 else 0.0) + (if 2 < len then c2 * 0.16000000000000003 else 0.0) + (if 3 < len then c3 * 0.06400000000000002 else 0.0) + (if 4 < len then c4 * 0.025600000000000005 else 0.0)), if (oidx = 3) then 40000.0 else 1.0), 27.76621455275837) in
