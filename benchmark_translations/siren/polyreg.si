let () = observe(gaussian(if (oidx = 5) then 0.0 else ((if 0 < len then c0 * 1.0 else 0.0) + (if 1 < len then c1 * 0.6 else 0.0) + (if 2 < len then c2 * 0.36 else 0.0) + (if 3 < len then c3 * 0.21599999999999997 else 0.0) + (if 4 < len then c4 * 0.1296 else 0.0)), if (oidx = 5) then 40000.0 else 1.0), 65.39877806912918) in
