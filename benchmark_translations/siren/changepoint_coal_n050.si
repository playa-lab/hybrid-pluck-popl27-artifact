let kl1 = kl0 - (if cp1 then 1.0 else 0.0) in
let s1 = s0 + (if cp1 then 1 else 0) in
let s = s1 in
let () = observe(poisson(if s = 0 then h0 else (if s = 1 then h1 else (if s = 2 then h2 else h3))), 5) in
