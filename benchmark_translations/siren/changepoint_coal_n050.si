


val draw_k = fun () ->
  let sample a <- bernoulli(0.36363636363636365) in
  if a then 0.0
  else (let sample b <- bernoulli(0.5714285714285714) in
    if b then 1.0
    else (let sample c <- bernoulli(0.6666666666666666) in
      if c then 2.0 else 3.0))
in
let symbolic h0 <- gamma(2.0, 1.0) in
let symbolic h1 <- gamma(2.0, 1.0) in
let symbolic h2 <- gamma(2.0, 1.0) in
let symbolic h3 <- gamma(2.0, 1.0) in
let kf = draw_k() in
let () = observe(poisson(h0), 4) in
let kl0 = kf in
let s0 = 0 in
