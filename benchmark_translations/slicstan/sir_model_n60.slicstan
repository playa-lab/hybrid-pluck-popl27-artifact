


data int[60] H;

real recovery;    recovery    ~ beta(1.0, 1.0);   
real infection;   infection   ~ beta(1.0, 1.0);   
real baseline;    baseline    ~ beta(0.2, 1.0);   
real symptomatic; symptomatic ~ beta(1.0, 1.0);   



H[1] ~ bernoulli(baseline);
int<2> s2 ~ categorical(to_vector([1 - infection, infection]));
H[2] ~ bernoulli((2-s2)*baseline + (1-(2-s2))*symptomatic);
int<2> s3 ~ categorical(to_vector([(2-s2)*(1-infection) + (1-(2-s2))*recovery, (2-s2)*infection + (1-(2-s2))*(1-recovery)]));
H[3] ~ bernoulli((2-s3)*baseline + (1-(2-s3))*symptomatic);
int<2> s4 ~ categorical(to_vector([(2-s3)*(1-infection) + (1-(2-s3))*recovery, (2-s3)*infection + (1-(2-s3))*(1-recovery)]));
