



data real[2][3] y;

vector[3] pi = to_vector([0.34, 0.33, 0.33]);
real[3][3] muc;
muc[1][1] ~ normal(-3, 3.0); muc[1][2] ~ normal(-3, 3.0); muc[1][3] ~ normal(-3, 3.0);
muc[2][1] ~ normal(3, 3.0); muc[2][2] ~ normal(3, 3.0); muc[2][3] ~ normal(3, 3.0);
muc[3][1] ~ normal(3, 3.0); muc[3][2] ~ normal(-3, 3.0); muc[3][3] ~ normal(-3, 3.0);

int<3> z1 ~ categorical(pi);
int<3> z2 ~ categorical(pi);

y[1][1] ~ normal(muc[z1][1], 1.0);
y[1][2] ~ normal(muc[z1][2], 1.0);
y[1][3] ~ normal(muc[z1][3], 1.0);
y[2][1] ~ normal(muc[z2][1], 1.0);
y[2][2] ~ normal(muc[z2][2], 1.0);
y[2][3] ~ normal(muc[z2][3], 1.0);
