y[5][3] ~ normal(muc[z5][3], 1.0);
y[6][1] ~ normal(muc[z6][1], 1.0);
y[6][2] ~ normal(muc[z6][2], 1.0);
y[6][3] ~ normal(muc[z6][3], 1.0);
y[7][1] ~ normal(muc[z7][1], 1.0);
y[7][2] ~ normal(muc[z7][2], 1.0);
