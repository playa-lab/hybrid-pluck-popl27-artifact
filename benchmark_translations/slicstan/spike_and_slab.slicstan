



data matrix[13, 4] X;
data vector[13] y;

int<2> g1 ~ bernoulli(0.5);
int<2> g2 ~ bernoulli(0.5);
int<2> g3 ~ bernoulli(0.5);
int<2> g4 ~ bernoulli(0.5);
real bs1 ~ normal(0, 10);
real bs2 ~ normal(0, 10);
real bs3 ~ normal(0, 10);
real bs4 ~ normal(0, 10);
real b0 ~ normal(0, 100);

y[1] ~ normal(b0 + g1 * bs1 * X[1][1] + g2 * bs2 * X[1][2] + g3 * bs3 * X[1][3] + g4 * bs4 * X[1][4], 2.5);
y[2] ~ normal(b0 + g1 * bs1 * X[2][1] + g2 * bs2 * X[2][2] + g3 * bs3 * X[2][3] + g4 * bs4 * X[2][4], 2.5);
