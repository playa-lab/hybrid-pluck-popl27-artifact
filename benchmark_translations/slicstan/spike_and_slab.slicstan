y[6] ~ normal(b0 + g1 * bs1 * X[6][1] + g2 * bs2 * X[6][2] + g3 * bs3 * X[6][3] + g4 * bs4 * X[6][4], 2.5);
y[7] ~ normal(b0 + g1 * bs1 * X[7][1] + g2 * bs2 * X[7][2] + g3 * bs3 * X[7][3] + g4 * bs4 * X[7][4], 2.5);
y[8] ~ normal(b0 + g1 * bs1 * X[8][1] + g2 * bs2 * X[8][2] + g3 * bs3 * X[8][3] + g4 * bs4 * X[8][4], 2.5);
y[9] ~ normal(b0 + g1 * bs1 * X[9][1] + g2 * bs2 * X[9][2] + g3 * bs3 * X[9][3] + g4 * bs4 * X[9][4], 2.5);
y[10] ~ normal(b0 + g1 * bs1 * X[10][1] + g2 * bs2 * X[10][2] + g3 * bs3 * X[10][3] + g4 * bs4 * X[10][4], 2.5);
y[11] ~ normal(b0 + g1 * bs1 * X[11][1] + g2 * bs2 * X[11][2] + g3 * bs3 * X[11][3] + g4 * bs4 * X[11][4], 2.5);
y[12] ~ normal(b0 + g1 * bs1 * X[12][1] + g2 * bs2 * X[12][2] + g3 * bs3 * X[12][3] + g4 * bs4 * X[12][4], 2.5);
y[13] ~ normal(b0 + g1 * bs1 * X[13][1] + g2 * bs2 * X[13][2] + g3 * bs3 * X[13][3] + g4 * bs4 * X[13][4], 2.5);
