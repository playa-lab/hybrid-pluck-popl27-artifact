




data real[7] y;

real[9] mu;
mu[1] ~ normal(-3, 1);
mu[2] ~ normal(-1.5, 1);
mu[3] ~ normal(-0.5, 1);
mu[4] ~ normal(1, 1);
mu[5] ~ normal(0, 1);
mu[6] ~ normal(2, 1);
mu[7] ~ normal(0, 1);
mu[8] ~ normal(0, 1);
mu[9] ~ normal(3.5, 1);

vector[3] init = to_vector([0.5, 0.3, 0.2]);
vector[3][3] trans;
trans[1] = to_vector([0.6, 0.3, 0.1]);
trans[2] = to_vector([0.2, 0.6, 0.2]);
trans[3] = to_vector([0.1, 0.3, 0.6]);

int<3> z1 ~ categorical(init);
int<3> h1 ~ categorical(init);
int<3> z2 ~ categorical(trans[z1]);
int<3> h2 ~ categorical(trans[h1]);
int<3> z3 ~ categorical(trans[z2]);
int<3> h3 ~ categorical(trans[h2]);
int<3> z4 ~ categorical(trans[z3]);
int<3> h4 ~ categorical(trans[h3]);
int<3> z5 ~ categorical(trans[z4]);
int<3> h5 ~ categorical(trans[h4]);
int<3> z6 ~ categorical(trans[z5]);
int<3> h6 ~ categorical(trans[h5]);
int<3> z7 ~ categorical(trans[z6]);
int<3> h7 ~ categorical(trans[h6]);

int k1; if (z1 > 2) { if (h1 > 2) { k1 = 9; } else { if (h1 > 1) { k1 = 6; } else { k1 = 3; } } } else { if (z1 > 1) { if (h1 > 2) { k1 = 6; } else { if (h1 > 1) { k1 = 4; } else { k1 = 2; } } } else { if (h1 > 2) { k1 = 3; } else { if (h1 > 1) { k1 = 2; } else { k1 = 1; } } } }
y[1] ~ normal(mu[k1], 1);
int k2; if (z2 > 2) { if (h2 > 2) { k2 = 9; } else { if (h2 > 1) { k2 = 6; } else { k2 = 3; } } } else { if (z2 > 1) { if (h2 > 2) { k2 = 6; } else { if (h2 > 1) { k2 = 4; } else { k2 = 2; } } } else { if (h2 > 2) { k2 = 3; } else { if (h2 > 1) { k2 = 2; } else { k2 = 1; } } } }
y[2] ~ normal(mu[k2], 1);
int k3; if (z3 > 2) { if (h3 > 2) { k3 = 9; } else { if (h3 > 1) { k3 = 6; } else { k3 = 3; } } } else { if (z3 > 1) { if (h3 > 2) { k3 = 6; } else { if (h3 > 1) { k3 = 4; } else { k3 = 2; } } } else { if (h3 > 2) { k3 = 3; } else { if (h3 > 1) { k3 = 2; } else { k3 = 1; } } } }
y[3] ~ normal(mu[k3], 1);
int k4; if (z4 > 2) { if (h4 > 2) { k4 = 9; } else { if (h4 > 1) { k4 = 6; } else { k4 = 3; } } } else { if (z4 > 1) { if (h4 > 2) { k4 = 6; } else { if (h4 > 1) { k4 = 4; } else { k4 = 2; } } } else { if (h4 > 2) { k4 = 3; } else { if (h4 > 1) { k4 = 2; } else { k4 = 1; } } } }
y[4] ~ normal(mu[k4], 1);
int k5; if (z5 > 2) { if (h5 > 2) { k5 = 9; } else { if (h5 > 1) { k5 = 6; } else { k5 = 3; } } } else { if (z5 > 1) { if (h5 > 2) { k5 = 6; } else { if (h5 > 1) { k5 = 4; } else { k5 = 2; } } } else { if (h5 > 2) { k5 = 3; } else { if (h5 > 1) { k5 = 2; } else { k5 = 1; } } } }
y[5] ~ normal(mu[k5], 1);
int k6; if (z6 > 2) { if (h6 > 2) { k6 = 9; } else { if (h6 > 1) { k6 = 6; } else { k6 = 3; } } } else { if (z6 > 1) { if (h6 > 2) { k6 = 6; } else { if (h6 > 1) { k6 = 4; } else { k6 = 2; } } } else { if (h6 > 2) { k6 = 3; } else { if (h6 > 1) { k6 = 2; } else { k6 = 1; } } } }
y[6] ~ normal(mu[k6], 1);
int k7; if (z7 > 2) { if (h7 > 2) { k7 = 9; } else { if (h7 > 1) { k7 = 6; } else { k7 = 3; } } } else { if (z7 > 1) { if (h7 > 2) { k7 = 6; } else { if (h7 > 1) { k7 = 4; } else { k7 = 2; } } } else { if (h7 > 2) { k7 = 3; } else { if (h7 > 1) { k7 = 2; } else { k7 = 1; } } } }
y[7] ~ normal(mu[k7], 1);
