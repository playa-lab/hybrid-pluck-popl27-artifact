data int[20] counts;
data vector[19] tp;

real e ~ gamma(2, 1);
real l ~ gamma(2, 1);
int<19> tau ~ categorical(tp);

if (1 <= tau) { counts[1] ~ poisson(e); }
else { counts[1] ~ poisson(l); }
if (2 <= tau) { counts[2] ~ poisson(e); }
else { counts[2] ~ poisson(l); }
