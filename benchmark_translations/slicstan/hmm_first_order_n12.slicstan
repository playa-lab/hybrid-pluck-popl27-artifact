


data real[12] y;

real[3] mu;
mu[1] ~ normal(-2, 1);
mu[2] ~ normal(0, 1);
mu[3] ~ normal(2, 1);

vector[3] init = to_vector([0.5, 0.3, 0.2]);
vector[3][3] trans;
trans[1] = to_vector([0.6, 0.3, 0.1]);
trans[2] = to_vector([0.2, 0.6, 0.2]);
trans[3] = to_vector([0.1, 0.3, 0.6]);

int<3> z1 ~ categorical(init);
int<3> z2 ~ categorical(trans[z1]);
int<3> z3 ~ categorical(trans[z2]);
int<3> z4 ~ categorical(trans[z3]);
int<3> z5 ~ categorical(trans[z4]);
int<3> z6 ~ categorical(trans[z5]);
int<3> z7 ~ categorical(trans[z6]);
int<3> z8 ~ categorical(trans[z7]);
int<3> z9 ~ categorical(trans[z8]);
int<3> z10 ~ categorical(trans[z9]);
int<3> z11 ~ categorical(trans[z10]);
int<3> z12 ~ categorical(trans[z11]);

y[1] ~ normal(mu[z1], 1);
y[2] ~ normal(mu[z2], 1);
y[3] ~ normal(mu[z3], 1);
y[4] ~ normal(mu[z4], 1);
y[5] ~ normal(mu[z5], 1);
y[6] ~ normal(mu[z6], 1);
y[7] ~ normal(mu[z7], 1);
y[8] ~ normal(mu[z8], 1);
y[9] ~ normal(mu[z9], 1);
y[10] ~ normal(mu[z10], 1);
y[11] ~ normal(mu[z11], 1);
y[12] ~ normal(mu[z12], 1);
