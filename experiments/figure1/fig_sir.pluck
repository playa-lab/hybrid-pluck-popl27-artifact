;; title: Figure 1 row -- SIR epidemic model
;; Three patients report daily symptoms for 10 days. Each patient's latent
;; infection status evolves as a hidden Markov chain governed by four shared
;; continuous rates (all Beta-distributed). Exact joint posterior over every
;; patient's day-by-day infection status and the four rates.
(define symptom-histories
  [[false, false, true,  true,  true,  true,  true,  false, false, false],
   [false, true,  true,  false, false, true,  true,  false, false, false],
   [false, false, false, false, false, false, false, false, false, false]])

(define n-days 10)

(define-type param
  (RecoveryRate)
  (InfectionRate)
  (BaselineSymptomRate)
  (InfectedSymptomRate))

(define (prior)
  (let ((rec (beta 2.0 4.0))
        (inf (beta 1.0 6.0))
        (bas (beta 1.0 12.0))
        (sym (beta 3.0 2.0)))
    (fn p ->
      (match p
        RecoveryRate => rec
        InfectionRate => inf
        BaselineSymptomRate => bas
        InfectedSymptomRate => sym))))

(define (transition infected params)
  (if infected
    (not (flip (params (RecoveryRate))))
    (flip (params (InfectionRate)))))

(define (generate-observation infected params)
  (if infected
    (flip (params (InfectedSymptomRate)))
    (flip (params (BaselineSymptomRate)))))

(define (hmm state params)
  (let ((next-state (transition state params)))
    (Cons
     (Pair state (generate-observation state params))
     (hmm next-state params))))

(define (matches-history history chain)
  (match history
    Nil => (True)
    Cons h hs => (match chain
                   Cons c cs => (and (iff (snd c) h) (matches-history hs cs)))))

(define (all-true bs)
  (match bs
    Nil => (True)
    Cons b bs => (and b (all-true bs))))

(define (evidence chains)
  (all-true (zip_with matches-history symptom-histories chains)))

;; posterior over the four shared rates, marginalizing all infection chains
(query sir-rates
  (let ((params (prior))
        (chains (map (fn h -> (take n-days (hmm (flip (params (InfectionRate))) params))) symptom-histories)))
    (Posterior
     [(params (RecoveryRate)), (params (InfectionRate)),
      (params (BaselineSymptomRate)), (params (InfectedSymptomRate))]
     (evidence chains))))

;; --- auxiliary queries (figure panels only; not counted in LoC) ---
;; posterior over each patient's latent day-by-day infection status
(query sir-patient-0
  (let ((params (prior))
        (chains (map (fn h -> (take n-days (hmm (flip (params (InfectionRate))) params))) symptom-histories)))
    (Posterior (map fst (index 0 chains)) (evidence chains))))

(query sir-patient-1
  (let ((params (prior))
        (chains (map (fn h -> (take n-days (hmm (flip (params (InfectionRate))) params))) symptom-histories)))
    (Posterior (map fst (index 1 chains)) (evidence chains))))

(query sir-patient-2
  (let ((params (prior))
        (chains (map (fn h -> (take n-days (hmm (flip (params (InfectionRate))) params))) symptom-histories)))
    (Posterior (map fst (index 2 chains)) (evidence chains))))
