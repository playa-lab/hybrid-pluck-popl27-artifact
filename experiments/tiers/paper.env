# The paper's configuration (§6.1) on the programs the paper uses: 15 repeats,
# 600 s timeout and the full sampler-budget sweeps. Pluck runs every benchmark
# (Tables 2-5); each baseline runs the programs behind its cells in Tables 2 and 3
# (Turing, SlicStan and Siren appear in Table 3 only). The baselines' other
# programs, mostly in-between sizes, are in the extra tier.
# This takes days of CPU time; see README.md.
N=15
TIMEOUT=600
PROGRAMS_PSI='@table2 @table3'
PROGRAMS_HYBIT='@table2 @table3'
PROGRAMS_TURING='@table3'
PROGRAMS_SLICSTAN='@table3'
PROGRAMS_SIREN='@table3'
TURING_SWEEP='4:50 8:50 8:100 16:100 16:200 32:200 32:400 64:400 64:800 128:800 128:1600'
SLICSTAN_SWEEP='250 500 1000 2000 4000 8000 16000'
SIREN_SWEEP='25 50 100 200 400 800 1600 3200 6400 12800 25600'
# Figure 1: median of 15 timing runs; PSI ports time out after 600 s.
FIG1_TIME=15
FIG1_PSI_TIMEOUT=600
