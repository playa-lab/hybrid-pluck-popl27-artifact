# A shorter version of the paper tier, sized for a laptop (see README.md for the
# time it takes): the same programs, 3 repeats instead of 15, a 300 s timeout for
# the baselines, and a subset of the paper's sampler budgets. Pluck keeps the
# paper's 600 s timeout. The largest Pluck programs need more memory than a 16 GB
# machine gives Docker; add FILTER_PLUCK='!@large' to skip them.
N=3
TIMEOUT=300
TIMEOUT_PLUCK=600
PROGRAMS_PSI='@table2 @table3'
PROGRAMS_HYBIT='@table2 @table3'
PROGRAMS_TURING='@table3'
PROGRAMS_SLICSTAN='@table3'
PROGRAMS_SIREN='@table3'
TURING_SWEEP='8:50 16:100 32:200 64:400'
SLICSTAN_SWEEP='500 2000'
SIREN_SWEEP='100 400 1600'
# Figure 1: median of 5 timing runs; PSI ports time out after 600 s, as in the paper.
FIG1_TIME=5
FIG1_PSI_TIMEOUT=600
