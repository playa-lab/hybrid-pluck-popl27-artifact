# The baselines' programs that no paper table uses, mostly the in-between sizes of
# the scaling families, with the paper tier's settings. Pluck does not run: its
# timings for these programs are part of the paper tier (Table 5), and the
# baselines' errors use the fixed exact answers in reference/exact_answers.csv.
# This takes days of CPU time; see README.md.
SUITE_SYSTEMS='psi hybit turing slicstan siren'
N=15
TIMEOUT=600
PROGRAMS_PSI='!@table2 !@table3'
PROGRAMS_HYBIT='!@table2 !@table3'
PROGRAMS_TURING='!@table3'
PROGRAMS_SLICSTAN='!@table3'
PROGRAMS_SIREN='!@table3'
TURING_SWEEP='4:50 8:50 8:100 16:100 16:200 32:200 32:400 64:400 64:800 128:800 128:1600'
SLICSTAN_SWEEP='250 500 1000 2000 4000 8000 16000'
SIREN_SWEEP='25 50 100 200 400 800 1600 3200 6400 12800 25600'
