<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <FsYacc Include="Parser.fsy"><OtherFlags>--module Parser</OtherFlags></FsYacc>
    <FsLex Include="Lexer.fsl"><OtherFlags>--module Lexer --unicode</OtherFlags></FsLex>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="SlicStanSyntax.fs" />
    <Compile Include="Parser.fsi" />
    <Compile Include="Parser.fs" />
    <Compile Include="Lexer.fs" />
    <Compile Include="Map.fs" />
    <Compile Include="Util.fs" />
    <Compile Include="ConstraintSolver.fs" />
    <Compile Include="ConstraintSimplification.fs" />
    <Compile Include="Typecheck.fs" />
    <Compile Include="Factorgraph.fs" />
    <Compile Include="Elaborate.fs" />
    <Compile Include="Shredding.fs" />
    <Compile Include="Enumerate.fs" />
    <Compile Include="MiniStanSyntax.fs" />
    <Compile Include="Transformation.fs" />
    <Compile Include="Examples.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FsLexYacc" Version="10.0.0" />
    <PackageReference Include="FsLexYacc.Runtime" Version="10.0.0" />
  </ItemGroup>
  <!-- Z3: the NuGet package (x64 only), or a locally built Microsoft.Z3.dll given
       with -p:Z3Dll=PATH (used on arm64). -->
  <ItemGroup Condition="'$(Z3Dll)' == ''">
    <PackageReference Include="Microsoft.Z3" Version="4.8.11" />
  </ItemGroup>
  <ItemGroup Condition="'$(Z3Dll)' != ''">
    <Reference Include="Microsoft.Z3"><HintPath>$(Z3Dll)</HintPath></Reference>
  </ItemGroup>
</Project>
