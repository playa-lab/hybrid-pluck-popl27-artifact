(define n-members 8)

;; (Ballot <participant idxs> <observed yes-majority>)
(define-type ballot (Ballot any any))

;; each ballot: (Ballot [participating member idxs] <observed yes-majority>)
(define ballots
  [(Ballot [0 1 2 3 4] true)
   (Ballot [2 3 4 5 6] true)
   (Ballot [4 5 6 7 0] false)
   (Ballot [6 7 0 1 2] false)])

;; ---------- model ----------
(define a 1.0) (define b 1.0)        ;; Beta(1,1) = Uniform[0,1] prior per member

;; count the yes-votes among the members in `idxs`: each casts a secret ballot
;; ~ Bernoulli(p_m); returns the (Peano nat) tally of yes-votes.
(define (count-yes ps idxs)
  (match idxs
    Nil => 0
    Cons i rest =>
      (let ((rest-yes (count-yes ps rest)))
        (if (flip (index i ps)) (S rest-yes) rest-yes))))

;; strict yes-majority among the subset: 2*yes > |subset|.
(define (yes-majority? ps idxs)
  (< (length idxs) (* 2 (count-yes ps idxs))))

;; observe one ballot: the latent majority must equal the reported outcome.
(define (obs-ballot ps bal)
  (match bal
    Ballot idxs outcome => (iff (yes-majority? ps idxs) outcome)))

(define (obs-all ps bals)
  (match bals
    Nil => (True)
    Cons bal rest => (and (obs-ballot ps bal) (obs-all ps rest))))

;; Posterior over only the FIRST member's yes-tendency p_0 given the public
;; majority outcomes, marginalising out the secret individual ballots AND every
;; other member's tendency. Querying a single member should keep the reported
;; mixture small (only p_0's sufficient statistic survives).
(query secret-ballot
  (let ((ps (map (fn m -> (beta a b)) (range n-members))))
    (Posterior (index 0 ps) (obs-all ps ballots))))
