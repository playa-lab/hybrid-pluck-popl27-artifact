(include "examples/shared/soccer.pluck")

(define team-names ["T0" "T1" "T2" "T3" "T4" "T5" "T6"])

(define scores
  [(Game 0 1 @0 @3) (Game 0 2 @3 @2) (Game 0 3 @1 @2) (Game 0 4 @2 @1) (Game 0 5 @2 @1)
   (Game 0 6 @5 @2) (Game 1 0 @2 @0) (Game 1 2 @2 @0) (Game 1 3 @0 @2) (Game 1 4 @1 @0)
   (Game 1 5 @0 @1) (Game 1 6 @1 @1) (Game 2 0 @3 @1) (Game 2 1 @1 @2) (Game 2 3 @1 @1)
   (Game 2 4 @2 @0) (Game 2 5 @2 @0) (Game 2 6 @2 @1) (Game 3 0 @1 @4) (Game 3 1 @1 @0)
   (Game 3 2 @1 @2) (Game 3 4 @2 @1) (Game 3 5 @5 @1) (Game 3 6 @6 @3) (Game 4 0 @0 @0)
   (Game 4 1 @1 @0) (Game 4 2 @1 @0) (Game 4 3 @1 @1) (Game 4 5 @0 @0) (Game 4 6 @0 @1)
   (Game 5 0 @2 @2) (Game 5 1 @1 @0) (Game 5 2 @1 @3) (Game 5 3 @3 @6) (Game 5 4 @1 @0)
   (Game 5 6 @2 @2) (Game 6 0 @4 @1) (Game 6 1 @3 @2) (Game 6 2 @3 @0) (Game 6 3 @8 @3)
   (Game 6 4 @3 @0) (Game 6 5 @3 @0)])

;; Posterior over team T0's identity label ("defend"/"balanced"/"attack"), given
;; every match score -- a 3-way categorical
(query soccer-T0-identity
  (let ((theta (dirichlet 1.0 1.0 1.0))
        (teams (make-teams theta (length team-names))))
    (Posterior (== (team-id (index 0 teams)) 2)
               (observe-scores teams scores))))
