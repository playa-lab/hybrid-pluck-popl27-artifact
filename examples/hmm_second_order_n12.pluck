(define obs [0.26, -1.18, 0.83, -2.02, -0.06, 0.89, -2.39, 0.77, 0.61, 0.29, -0.19, -1.79])

(include "examples/shared/hmm_second_order.pluck")

(query hmm-second-order
  (let ((m1 (normal -2.0 1.0)) (m2 (normal 0.0 1.0)) (m3 (normal 2.0 1.0))
        (z1 (initial-state)) (z2 (transition z1)))
    (Posterior m1 (chain-obs-start z1 z2 m1 m2 m3 obs))))
