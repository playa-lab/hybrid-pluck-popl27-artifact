(define n-members 128)

;; (Ballot <participant idxs> <observed yes-majority>)
(define-type ballot (Ballot any any))

;; each ballot: (Ballot [participating member idxs] <observed yes-majority>)
(define ballots
  [(Ballot [0 1 2 3 4] true)
   (Ballot [2 3 4 5 6] false)
   (Ballot [4 5 6 7 8] false)
   (Ballot [6 7 8 9 10] false)
   (Ballot [8 9 10 11 12] false)
   (Ballot [10 11 12 13 14] false)
   (Ballot [12 13 14 15 16] true)
   (Ballot [14 15 16 17 18] true)
   (Ballot [16 17 18 19 20] true)
   (Ballot [18 19 20 21 22] false)
   (Ballot [20 21 22 23 24] false)
   (Ballot [22 23 24 25 26] true)
   (Ballot [24 25 26 27 28] false)
   (Ballot [26 27 28 29 30] false)
   (Ballot [28 29 30 31 32] false)
   (Ballot [30 31 32 33 34] true)
   (Ballot [32 33 34 35 36] false)
   (Ballot [34 35 36 37 38] true)
   (Ballot [36 37 38 39 40] true)
   (Ballot [38 39 40 41 42] false)
   (Ballot [40 41 42 43 44] false)
   (Ballot [42 43 44 45 46] false)
   (Ballot [44 45 46 47 48] true)
   (Ballot [46 47 48 49 50] true)
   (Ballot [48 49 50 51 52] false)
   (Ballot [50 51 52 53 54] true)
   (Ballot [52 53 54 55 56] true)
   (Ballot [54 55 56 57 58] true)
   (Ballot [56 57 58 59 60] true)
   (Ballot [58 59 60 61 62] true)
   (Ballot [60 61 62 63 64] true)
   (Ballot [62 63 64 65 66] true)
   (Ballot [64 65 66 67 68] false)
   (Ballot [66 67 68 69 70] false)
   (Ballot [68 69 70 71 72] true)
   (Ballot [70 71 72 73 74] true)
   (Ballot [72 73 74 75 76] true)
   (Ballot [74 75 76 77 78] false)
   (Ballot [76 77 78 79 80] true)
   (Ballot [78 79 80 81 82] true)
   (Ballot [80 81 82 83 84] false)
   (Ballot [82 83 84 85 86] true)
   (Ballot [84 85 86 87 88] true)
   (Ballot [86 87 88 89 90] false)
   (Ballot [88 89 90 91 92] true)
   (Ballot [90 91 92 93 94] true)
   (Ballot [92 93 94 95 96] false)
   (Ballot [94 95 96 97 98] false)
   (Ballot [96 97 98 99 100] true)
   (Ballot [98 99 100 101 102] false)
   (Ballot [100 101 102 103 104] false)
   (Ballot [102 103 104 105 106] true)
   (Ballot [104 105 106 107 108] true)
   (Ballot [106 107 108 109 110] true)
   (Ballot [108 109 110 111 112] true)
   (Ballot [110 111 112 113 114] false)
   (Ballot [112 113 114 115 116] true)
   (Ballot [114 115 116 117 118] true)
   (Ballot [116 117 118 119 120] true)
   (Ballot [118 119 120 121 122] false)
   (Ballot [120 121 122 123 124] false)
   (Ballot [122 123 124 125 126] true)
   (Ballot [124 125 126 127 0] false)
   (Ballot [126 127 0 1 2] true)])

;; ---------- model ----------
(define a 1.0) (define b 1.0)        ;; Beta(1,1) = Uniform[0,1] prior per member

;; count the yes-votes among the members in `idxs`: each casts a secret ballot
;; ~ Bernoulli(p_m); returns the (Peano nat) tally of yes-votes.
(define (count-yes ps idxs)
  (match idxs
    Nil => 0
    Cons i rest =>
      (let ((rest-yes (count-yes ps rest)))
        (if (flip (index i ps)) (S rest-yes) rest-yes))))

;; strict yes-majority among the subset: 2*yes > |subset|.
(define (yes-majority? ps idxs)
  (< (length idxs) (* 2 (count-yes ps idxs))))

;; observe one ballot: the latent majority must equal the reported outcome.
(define (obs-ballot ps bal)
  (match bal
    Ballot idxs outcome => (iff (yes-majority? ps idxs) outcome)))

(define (obs-all ps bals)
  (match bals
    Nil => (True)
    Cons bal rest => (and (obs-ballot ps bal) (obs-all ps rest))))

;; Posterior over only the FIRST member's yes-tendency p_0 given the public
;; majority outcomes, marginalising out the secret individual ballots AND every
;; other member's tendency. Querying a single member should keep the reported
;; mixture small (only p_0's sufficient statistic survives).
(query secret-ballot
  (let ((ps (map (fn m -> (beta a b)) (range n-members))))
    (Posterior (index 0 ps) (obs-all ps ballots))))
